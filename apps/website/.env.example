# Server-only; do not use NEXT_PUBLIC_ for backend connection configuration.
MEMBERSHIP_API_ORIGIN=https://localhost:7198
# Set to the actual HTTPS public site in production for canonical metadata.
WEBSITE_PUBLIC_ORIGIN=http://localhost:3000

# Public staff portal. Set the real HTTPS origin before deployment.
# Development defaults to https://localhost:5173; production fallback is /staff.
MANAGEMENT_PUBLIC_ORIGIN=https://localhost:5173
