# Staging template only. Replace secrets in Coolify; never commit filled values.
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__DefaultConnection=Host=qsjcyvpeohtvxnsg5in2fyt3;Port=5432;Database=theone_staging;Username=theone_staging_user;Password=REPLACE_IN_COOLIFY
Jwt__Issuer=TheOne.Staging
Jwt__Audience=TheOne.Staging
Jwt__SecretKey=REPLACE_WITH_SEPARATE_STAGING_SECRET_AT_LEAST_32_BYTES
AllowedHosts=api-staging.theone.markerbd.com;staff-staging.theone.markerbd.com
Browser__AllowedOrigins__0=https://staff-staging.theone.markerbd.com
DataProtection__KeysPath=/app/data-protection-keys
# Optional at-rest key protection certificate, mounted separately from the image:
# DataProtection__CertificatePath=/run/secrets/staging-data-protection.pfx
# DataProtection__CertificatePassword=REPLACE_IN_COOLIFY
ReverseProxy__Enabled=true
ReverseProxy__ForwardLimit=1
# REQUIRED BEFORE STARTUP: hosting must create the dedicated TheOne staging proxy
# network and provide its actual CIDR. No trusted address is guessed here.
# ReverseProxy__KnownNetworks__0=REPLACE_DEDICATED_STAGING_PROXY_CIDR
# Current Coolify IP 10.0.1.2 is dynamic (IPAMConfig=null), not a permanent trust entry.
# Do not trust the shared coolify subnet 10.0.1.0/24.
# With proxy handling enabled and no trusted peers configured, API startup fails
# intentionally. Complete the actual dedicated-network setting in Coolify first.
# Never set ASPNETCORE_FORWARDEDHEADERS_ENABLED=true.
SmsProvider__Enabled=false
