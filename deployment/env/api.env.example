# Example only: replace placeholders in host secret settings. Never commit filled values.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__DefaultConnection=Host=REPLACE_INTERNAL_HOST;Database=theone_prod;Username=theone_prod_user;Password=REPLACE_SECRET
Jwt__Issuer=TheOne
Jwt__Audience=TheOne
Jwt__SecretKey=REPLACE_WITH_EXISTING_OR_SECURE_RANDOM_SIGNING_KEY
AllowedHosts=api.theone.markerbd.com;staff.theone.markerbd.com
Browser__AllowedOrigins__0=https://staff.theone.markerbd.com
DataProtection__KeysPath=/app/data-protection-keys
# Optional certificate to encrypt persisted keys; store outside image and web root:
# DataProtection__CertificatePath=/run/secrets/data-protection.pfx
# DataProtection__CertificatePassword=SET_IN_SECRET_STORE
ReverseProxy__Enabled=true
ReverseProxy__ForwardLimit=1
# Supply actual IMMEDIATE trusted proxy address/network. No guessed subnet.
# ReverseProxy__KnownProxies__0=REPLACE_ACTUAL_PROXY_IP
# ReverseProxy__KnownNetworks__0=REPLACE_ACTUAL_TRUSTED_CIDR
# Never set ASPNETCORE_FORWARDEDHEADERS_ENABLED=true.
SmsProvider__Enabled=false
